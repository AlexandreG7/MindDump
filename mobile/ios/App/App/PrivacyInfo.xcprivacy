<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manifeste de confidentialité exigé par l'App Store (docs/app-mobile.md, 4.1).
  Doit rester aligné avec les étiquettes de confidentialité d'App Store Connect.
