{
  "name": "minddump-mcp",
  "version": "1.0.0",
  "description": "MCP server for MindDump — manage recipes, todos, and shopping lists from Claude",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:sse": "MCP_TRANSPORT=sse tsx src/index.ts",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:sse": "MCP_TRANSPORT=sse tsx watch src/index.ts",
    "test:safe-fetch": "tsx --test src/safeFetch.test.ts",
    "test:kids": "tsx --test src/kids.test.ts",
    "test:kids-integration": "tsx --test src/kids.integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
