generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth models ────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  publicId      String?   @unique @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  calendarToken String?   @unique
  weatherLat    Float?
  weatherLon    Float?
  weatherCity   String?
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  // Preuve du consentement RGPD : date et version du texte accepté (voir src/lib/consent.ts)
  consentedAt    DateTime?
  consentVersion String?
  // Rappels (cron/notify) par e-mail ; les notifications push dépendent, elles,
  // des appareils abonnés (PushSubscription).
  notifyEmail    Boolean   @default(true)

  accounts              Account[]
  sessions              Session[]
  todos                 Todo[]
  calendarEvents        CalendarEvent[]
  calendarSubscriptions CalendarSubscription[]
  shoppingLists         ShoppingList[]
  recipes               Recipe[]
  recipeFavorites       RecipeFavorite[]
  ownedGroups           Group[]         @relation("GroupOwner")
  groupMemberships      GroupMember[]
  featureFlags          UserFeatureFlag[]
  apiKeys               ApiKey[]
  kidDayEntries         KidDayEntry[]
  loginEvents           LoginEvent[]
  familyProfiles        FamilyProfile[]
  wallDevices           WallDevice[]
  pushSubscriptions     PushSubscription[]

  @@index([createdAt])
}

// Historique des connexions (statistiques admin). Alimenté par l'event signIn de
// NextAuth : la stratégie JWT ne remplit pas la table Session.
model LoginEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  provider  String?  // "credentials" | "google"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─── API Keys (pour MCP et intégrations externes) ────────────

// Abonnement Web Push d'un appareil (navigateur ou PWA installée). L'endpoint,
// fourni par le service push du navigateur, identifie l'appareil : un même
// appareil qui change de compte est réattribué au dernier abonné.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// Code à usage unique de la connexion depuis l'app mobile (docs/app-mobile.md,
// étape 2.1) : émis par le navigateur système après la connexion OAuth, échangé
// par l'app contre une session. Valable 60 secondes. Pas de relation vers User :
// l'échange vérifie que le compte existe encore, et les codes expirés sont purgés
// à chaque émission.
model MobileAuthCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  challenge String
  userId    String
  provider  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Appareil connecté par l'app mobile (étape 2.2) : son id est porté par le jeton
// de session, et le callback jwt refuse un appareil qui n'existe plus (révoquer =
// supprimer la ligne). Comme
// MobileAuthCode, pas de relation vers User ; suppression explicite avec le
// compte (src/lib/account.ts).
model MobileDevice {
  id         String    @id @default(cuid())
  userId     String
  name       String
  platform   String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String   @default("MCP")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
}

model UserFeatureFlag {
  id      String  @id @default(cuid())
  feature String  // "todos" | "calendar" | "lists" | "recipes"
  enabled Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
}

// ─── Groupes ─────────────────────────────────────────────────

model Group {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shareTodos    Boolean @default(true)
  shareCalendar Boolean @default(true)
  shareLists    Boolean @default(true)
  shareRecipes  Boolean @default(true)

  ownerId String
  owner   User   @relation("GroupOwner", fields: [ownerId], references: [id])

  members        GroupMember[]
  invites        GroupInvite[]
  todos          Todo[]
  calendarEvents CalendarEvent[]
  calendarSubscriptions CalendarSubscription[]
  shoppingLists  ShoppingList[]
  recipes        Recipe[]
  profiles       FamilyProfile[]
  wallDevices    WallDevice[]

  @@index([ownerId])
}

model GroupMember {
  id       String   @id @default(cuid())
  role     String   @default("member") // "admin" | "member"
  joinedAt DateTime @default(now())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupInvite {
  id        String    @id @default(cuid())
  email     String?
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([token])
}

enum TodoPriority {
  URGENT
  PLANNED
}

model Todo {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    TodoPriority @default(URGENT)
  dueDate     DateTime?
  completed   Boolean      @default(false)
  recurrence  String?      // "daily" | "weekly" | "biweekly" | "monthly" | null
  notifyBefore Int?        // minutes before dueDate
  notified    Boolean      @default(false)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  assignees TodoAssignee[]

  @@index([userId, completed])
  @@index([groupId])
  @@index([dueDate])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  recurrence  String?   // "daily", "weekly", "biweekly", "monthly", or null
  color       String?   // hex color, e.g. "#3b82f6"
  notifyBefore Int?     // minutes before event
  notified    Boolean   @default(false)
  // Evenement recurrent : date de la derniere occurrence deja rappelee.
  notifiedOccurrence DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  assignees EventAssignee[]

  @@index([userId, date])
  @@index([groupId])
}

model CalendarSubscription {
  id        String   @id @default(cuid())
  name      String
  url       String
  color     String   @default("#3b82f6")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([groupId])
}

enum ShoppingListType {
  GROCERY
  ONLINE
}

model ShoppingList {
  id        String           @id @default(cuid())
  name      String
  type      ShoppingListType @default(GROCERY)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  items   ShoppingItem[]

  @@index([userId])
  @@index([groupId])
}

model ShoppingItem {
  id       String  @id @default(cuid())
  name     String
  quantity String?
  checked  Boolean @default(false)
  category String?
  url      String? // for online purchases
  price    Float?  // for online purchases
  store    String? // for online purchases

  listId   String
  list     ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([recipeId])
}

model Recipe {
  id          String  @id @default(cuid())
  title       String
  description String?
  servings    Int     @default(4)
  prepTime    Int?    // minutes
  cookTime    Int?    // minutes
  steps       String  @db.Text // JSON array of steps
  image       String?
  shareToken  String? @unique // lien de partage public, null = non partagé
  planned     Boolean @default(false)
  inCatalog   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  ingredients  RecipeIngredient[]
  shoppingItems ShoppingItem[]
  favorites    RecipeFavorite[]

  @@index([userId])
  @@index([groupId])
  @@index([createdAt])
}

// Favori propre à chaque utilisateur : une recette partagée dans un groupe peut
// être en favori pour un membre sans l'être pour les autres.
model RecipeFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, recipeId])
  @@index([recipeId])
}

model RecipeIngredient {
  id       String @id @default(cuid())
  name     String
  quantity String
  unit     String?

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model KidDayEntry {
  id         String   @id @default(cuid())
  date       String
  weather    String?
  mood       String?
  nap        Boolean?
  accident   Boolean?
  activities String   @default("[]") @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Auteur de la saisie.
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Enfant concerné. Nul seulement pour les saisies antérieures aux profils,
  // rattachées au démarrage par prisma/backfill-kid-profiles.js.
  profileId String?
  profile   FamilyProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([userId])
}

// Personne du foyer, avec ou sans compte (un enfant n'a pas de compte). Brique
// commune pour la couleur par personne, l'assignation, le semainier, etc.
// Le profil d'un membre (userId non nul) est créé et retiré avec son adhésion
// (src/lib/profiles.ts).
model FamilyProfile {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("adult") // "adult" | "child"
  color     String   @default("#3b82f6")
  emoji     String?
  birthDate String?  // "yyyy-MM-dd"
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId String
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kidDayEntries    KidDayEntry[]
  eventAssignments EventAssignee[]
  todoAssignments  TodoAssignee[]

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// Personnes du foyer concernées par un événement ou une tâche (profils du
// groupe de l'élément, voir src/lib/profiles.ts). Retirer une personne du foyer
// retire ses assignations, jamais l'élément.
model EventAssignee {
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profileId String
  profile   FamilyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([eventId, profileId])
  @@index([profileId])
}

model TodoAssignee {
  todoId    String
  todo      Todo          @relation(fields: [todoId], references: [id], onDelete: Cascade)
  profileId String
  profile   FamilyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([todoId, profileId])
  @@index([profileId])
}

// Écran mural (tablette fixée au mur) : accès sans session au tableau du
// groupe par un lien secret. Seule l'empreinte du jeton est stockée ; le
// supprimer révoque l'écran. Voir src/lib/wall.ts.
model WallDevice {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  groupId     String
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([groupId])
}
